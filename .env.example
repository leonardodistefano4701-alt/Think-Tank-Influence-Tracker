# Copy to .env and fill in. Never commit .env.
# No script carries a default credential; a missing key fails loudly.

# api.data.gov key, used for FEC (api.open.fec.gov) and Congress.gov.
# Get one at https://api.data.gov/signup/
FEC_API_KEY=

# GovInfo API key. Only needed for api.govinfo.gov endpoints — the bulkdata
# downloads used by import_bulk_bills.py and repair_bill_status.py are public.
GOVINFO_API_KEY=

# Perplexity, used by collect_perplexity.py and generate_ai_synthesis.py.
# These two scripts produced all of the AI analysis currently in the database.
PERPLEXITY_API_KEY=

# OpenRouter, used by the data-pipeline analyzer layer.
OPENROUTER_API_KEY=

# NY Times Article Search, used by the (currently unused) nytimes collector.
NYT_API_KEY=

# Optional: override the SQLite location. Defaults to web/data/ttit.db.
# DB_PATH=

LDA_API_KEY=your_senate_lda_api_key_here
